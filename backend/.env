# Default local SQLite database (zero external setup needed)
DATABASE_URL="file:./dev.db"

# To switch to PostgreSQL, uncomment the line below and use prisma/schema.postgresql.prisma:
# DATABASE_URL="postgresql://skillset_user:skillset_pass@localhost:5432/skillset_ai"

JWT_SECRET="skillset-ai-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
BCRYPT_ROUNDS=10
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
