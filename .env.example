# SkillSet AI Environment Configuration Example
# Copy to .env and configure strong values for your deployment.
# NEVER commit real secrets or production keys to version control.

# Application Environment (development | staging | production)
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/skillset_ai
# For local SQLite dev: DATABASE_URL="file:./dev.db"

# Authentication Secrets (Must be at least 32 characters high-entropy strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowlist (comma-separated origins, no wildcards allowed)
ALLOWED_ORIGINS=http://localhost:5173

# File Storage Configuration
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE_MB=10

# Security Rate Limiting & Lockout
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_WINDOW_MS=60000
